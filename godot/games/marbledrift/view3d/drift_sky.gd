## Camera-facing cloud sprites as one MultiMesh: puffs = [[offset, width, height], ...] round pos.
func _cloud_sprites(nm: String, rng: RandomNumberGenerator, pos: Vector3, puffs: Array, m: ShaderMaterial) -> Node3D:
	var q := QuadMesh.new()
	q.size = Vector2(1, 1)
	var mm := MultiMesh.new()
	mm.transform_format = MultiMesh.TRANSFORM_3D
	mm.use_colors = true
	mm.mesh = q
	mm.instance_count = puffs.size()
	for i in puffs.size():
		var pf: Array = puffs[i]
		mm.set_instance_transform(i, Transform3D(Basis().scaled(Vector3(pf[1], pf[2], 1.0)), pf[0]))
		mm.set_instance_color(i, Color(rng.randf(), rng.randf(), 0))
	var mmi := MultiMeshInstance3D.new()
	mmi.name = nm
	mmi.multimesh = mm
	mmi.material_override = m
	mmi.position = pos
	mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	mmi.custom_aabb = AABB(Vector3(-80, -40, -80), Vector3(160, 160, 160))
	add_child(mmi)
	return mmi


