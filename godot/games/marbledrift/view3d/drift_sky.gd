func _ribbon(rng: RandomNumberGenerator, length: float, hgt: float) -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var seg := 96
	var ph := rng.randf() * TAU
	var pts: Array = []
	for i in seg + 1:
		var u := float(i) / seg
		var x := (u - 0.5) * length
		var z := sin(u * 7.0 + ph) * length * 0.05 + sin(u * 17.0 + ph * 2.0) * length * 0.015
		pts.append(Vector3(x, 0, z))
	for i in seg:
		var u0 := float(i) / seg
		var u1 := float(i + 1) / seg
		var a: Vector3 = pts[i]
		var b: Vector3 = pts[i + 1]
		var quad := [[a, u0, 0.0], [b, u1, 0.0], [b + Vector3(0, hgt, 0), u1, 1.0],
				[a, u0, 0.0], [b + Vector3(0, hgt, 0), u1, 1.0], [a + Vector3(0, hgt, 0), u0, 1.0]]
		for q in quad:
			st.set_normal(Vector3.BACK)
			st.set_uv(Vector2(q[1], q[2]))
			st.add_vertex(q[0])
	return st.commit()


# --- shared pieces ---------------------------------------------------------------------------------------------

func _vc_material(rough: float) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.vertex_color_use_as_albedo = true
	m.roughness = rough
	m.rim_enabled = true
	m.rim = 0.35
	m.rim_tint = 0.6
	return m


## A floating island: a domed grassy top with a soil lip and a long jagged rock underside ending in a point, with
## optional little trees. Faceted (flat-shaded), coloured by vertex.
func _island_mesh(rng: RandomNumberGenerator, r: float, grass: Color, soil: Color, rock: Color, trees: int,
		leaf: Color, deep := true) -> ArrayMesh:
	var noise := FastNoiseLite.new()
	noise.seed = rng.randi()
	noise.frequency = 0.35
	var seg := 22
	# rings: [radius fraction, height (in r), kind 0 grass 1 soil 2 rock]
	var rings := [[0.35, 0.16, 0], [0.7, 0.1, 0], [1.0, 0.0, 0], [1.02, -0.18, 1], [0.92, -0.42, 2],
			[0.74, -0.75, 2], [0.5, -1.1, 2], [0.26, -1.45, 2]]
	if not deep:
		rings = [[0.35, 0.12, 0], [0.7, 0.07, 0], [1.0, 0.0, 1], [1.02, -0.2, 2], [0.86, -0.5, 2], [0.55, -0.85, 2],
				[0.25, -1.1, 2]]
	var pts: Array = []
	var kinds: Array = []
	for ri in rings.size():
		var ring: Array = []
		for s in seg:
			var a := TAU * s / seg
			var jag := 1.0 + 0.22 * noise.get_noise_2d(cos(a) * 3.0, sin(a) * 3.0 + ri * 1.7)
			var rr: float = rings[ri][0] * r * jag
			var y: float = rings[ri][1] * r + 0.12 * r * noise.get_noise_2d(cos(a) * 5.0 + ri, sin(a) * 5.0)
			ring.append(Vector3(cos(a) * rr, y, sin(a) * rr))
		pts.append(ring)
		kinds.append(rings[ri][2])
	var top := Vector3(0, r * 0.2, 0)
	var tip := Vector3(r * 0.1, -r * (1.9 if deep else 1.4), 0)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var cols := [grass, soil, rock]
	for s in seg:
		var n := (s + 1) % seg
		_tri(st, top, pts[0][s], pts[0][n], Vector3(0, -r * 2.0, 0), _vary(rng, grass, 0.06))
		for ri in rings.size() - 1:
			var k: int = kinds[ri + 1]
			var col: Color = cols[k]
			if k == 2:
				col = col * (0.82 + 0.18 * sin((pts[ri + 1][s] as Vector3).y * 2.2 / maxf(r * 0.1, 0.3)))
			var inside := Vector3(0, (pts[ri][s] as Vector3).y, 0)
			_tri(st, pts[ri][s], pts[ri + 1][s], pts[ri + 1][n], inside, _vary(rng, col, 0.08))
			_tri(st, pts[ri][s], pts[ri + 1][n], pts[ri][n], inside, _vary(rng, col, 0.08))
		_tri(st, pts[rings.size() - 1][s], tip, pts[rings.size() - 1][n], Vector3(0, tip.y * 0.5, 0),
				_vary(rng, rock * 0.75, 0.08))
	# little trees: a trunk and two stacked cones
	for i in trees:
		var a := rng.randf() * TAU
		var d := sqrt(rng.randf()) * r * 0.6
		var base := Vector3(cos(a) * d, r * 0.12 * (1.0 - d / r) + 0.02 * r, sin(a) * d)
		var th := rng.randf_range(1.6, 3.0)
		_cone(st, base, 0.18, th * 0.4, 5, Color("#6a4a34"))
		_cone(st, base + Vector3(0, th * 0.3, 0), th * 0.38, th * 0.7, 7, _vary(rng, leaf, 0.12))
		_cone(st, base + Vector3(0, th * 0.62, 0), th * 0.26, th * 0.55, 7, _vary(rng, leaf * 1.15, 0.12))
	return st.commit()


func _cone(st: SurfaceTool, base: Vector3, r: float, h: float, sides: int, col: Color) -> void:
	var apex := base + Vector3(0, h, 0)
	var inside := base + Vector3(0, h * 0.3, 0)
	for s in sides:
		var a0 := TAU * s / sides
		var a1 := TAU * (s + 1) / sides
		var p0 := base + Vector3(cos(a0) * r, 0, sin(a0) * r)
		var p1 := base + Vector3(cos(a1) * r, 0, sin(a1) * r)
		_tri(st, p0, apex, p1, inside, col)


func _vary(rng: RandomNumberGenerator, c: Color, k: float) -> Color:
	var f := 1.0 + (rng.randf() - 0.5) * 2.0 * k
	return Color(c.r * f, c.g * f, c.b * f)


func _tri(st: SurfaceTool, a: Vector3, b: Vector3, c: Vector3, inside: Vector3, col: Color) -> void:
	_tri_uv(st, [a, b, c], [0.0, 0.0, 0.0], inside, col)


## A lumpy faceted rock (radius about r), coloured from light to dark by height.
func _rock_mesh(rng: RandomNumberGenerator, light: Color, dark: Color, r: float) -> ArrayMesh:
	var sm := SphereMesh.new()
	sm.radius = 1.0
	sm.height = 2.0
	sm.radial_segments = 10
	sm.rings = 6
	var arr := sm.get_mesh_arrays()
	var vs: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
	var ix: PackedInt32Array = arr[Mesh.ARRAY_INDEX]
	var noise := FastNoiseLite.new()
	noise.seed = rng.randi()
	noise.frequency = 1.3
	var squash := Vector3(rng.randf_range(0.8, 1.3), rng.randf_range(0.6, 1.0), rng.randf_range(0.8, 1.3))
	var moved := PackedVector3Array()
	for v in vs:
		var k := 1.0 + 0.35 * noise.get_noise_3dv(v * 1.0)
		moved.append(v * k * squash * r)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for t in range(0, ix.size(), 3):
		var a := moved[ix[t]]
		var b := moved[ix[t + 1]]
		var c := moved[ix[t + 2]]
		if a.distance_to(b) < 1e-4 or b.distance_to(c) < 1e-4 or a.distance_to(c) < 1e-4:
			continue
		var y := ((a + b + c) / 3.0).y / (r * squash.y)
		_tri(st, a, b, c, Vector3.ZERO, _vary(rng, dark.lerp(light, clampf(0.5 + y * 0.5, 0.0, 1.0)), 0.1))
	return st.commit()


## Particles kept round the camera's focus: [GPUParticles3D, ParticleProcessMaterial].
func _particles(nm: String, amount: int, life: float, box: Vector3, shape: int, emit: float, size: Vector2) -> Array:
	var p := GPUParticles3D.new()
	p.name = nm
	p.amount = amount
	p.lifetime = life
	p.preprocess = life
	p.fixed_fps = 30
	p.use_fixed_seed = true
	p.seed = 47 + theme
	p.local_coords = false
	p.visibility_aabb = AABB(-box - Vector3(20, 60, 20), (box + Vector3(20, 60, 20)) * 2.0)
	p.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var pm := ParticleProcessMaterial.new()
	pm.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
	pm.emission_box_extents = box
	var q := QuadMesh.new()
	q.size = size
	var m := _shader("drift_particle", false)
	m.set_shader_parameter("shape", shape)
	m.set_shader_parameter("emit", emit)
	q.material = m
	p.draw_pass_1 = q
	p.process_material = pm
	add_child(p)
	return [p, pm]


func _add_motes(col: Color, amount: int, size: float, box: Vector3, grav := Vector3(0, 0.05, 0)) -> void:
	var r := _particles("motes", amount, 9.0, box, 0, 2.0, Vector2(size, size))
	var pm: ParticleProcessMaterial = r[1]
	pm.gravity = grav
	pm.initial_velocity_min = 0.05
	pm.initial_velocity_max = 0.3
	pm.direction = Vector3(0, 1, 0)
	pm.spread = 180.0
	pm.turbulence_enabled = true
	pm.turbulence_noise_strength = 0.4
	pm.turbulence_noise_scale = 4.0
	pm.color = col
	pm.scale_min = 0.5
	pm.scale_max = 1.5
	var ramp := Gradient.new()
	ramp.set_color(0, Color(1, 1, 1, 0))
	ramp.add_point(0.2, Color(1, 1, 1, 1))
	ramp.add_point(0.8, Color(1, 1, 1, 1))
	ramp.set_color(ramp.get_point_count() - 1, Color(1, 1, 1, 0))
	var gt := GradientTexture1D.new()
	gt.gradient = ramp
	pm.color_ramp = gt
	_focus_fx.append([r[0], Vector3(0, 4, 0)])


# --- animation -------------------------------------------------------------------------------------------------

func _place_follow() -> void:
	var cam := get_viewport().get_camera_3d() if is_inside_tree() else null
	if cam:
		_cam_pos = cam.global_position
	for f in _follow:
		var node: Node3D = f[0]
		node.position = Vector3(_cam_pos.x, f[1], _cam_pos.z)   # the backdrop sits at the origin
	if cam and not _focus_fx.is_empty():
		var fwd := -cam.global_transform.basis.z
		# where the view meets the course's height: roughly the marble
		var tt := clampf((cam.global_position.y - 4.0) / maxf(-fwd.y, 0.2), 5.0, 60.0)
		var focus := cam.global_position + fwd * tt
		for f in _focus_fx:
			(f[0] as Node3D).global_position = focus + (f[1] as Vector3)


func _process(delta: float) -> void:
	_t += delta
	for m in _clocked:
		(m as ShaderMaterial).set_shader_parameter("clock", _t)
	for b in _bob:
		var node: Node3D = b[0]
		var rest: Vector3 = b[1]
		var ph: float = _t * b[3] + b[4]
		node.position = rest + Vector3(0, sin(ph) * b[2], 0)
		if b[5] != 0.0:
			node.rotate_y(b[5] * delta)
	for s in _spin:
		(s[0] as Node3D).rotate_object_local(s[1], s[2] * delta)
	_place_follow()
	if _flash_light:
		_storm(delta)


## Lightning: every few seconds a strike somewhere in view below the course; the bolt flickers, the clouds and the
## towers light up from inside, the flash light catches the cliffs.
func _storm(_delta: float) -> void:
	if _t >= _next_strike:
		_strike_t = _t
		_next_strike = _t + _storm_rng.randf_range(2.5, 6.5)
		# somewhere in view: beyond the course from the camera (which looks towards -x -z), off to a side
		var a := deg_to_rad(-135.0) + _storm_rng.randf_range(-0.9, 0.9)
		var r := _storm_rng.randf_range(35.0, 90.0)
		_strike_pos = Vector3(_cam_pos.x + sin(a) * r, _deck_y, _cam_pos.z + cos(a) * r)
		_make_bolt()
	var age := _t - _strike_t
	var f := 0.0
	if age < 0.6:
		# two or three flickers
		f = exp(-age * 7.0) + 0.7 * exp(-pow((age - 0.18) * 30.0, 2.0)) + 0.5 * exp(-pow((age - 0.34) * 26.0, 2.0))
	var fl := Vector4(_strike_pos.x, _strike_pos.z, 45.0, f * 1.0)
	for m in _flash_mats:
		(m as ShaderMaterial).set_shader_parameter("flash", fl)
	_flash_light.position = _strike_pos + Vector3(0, 20, 0)
	_flash_light.light_energy = f * 3.0
	_bolt.visible = f > 0.25


func _make_bolt() -> void:
	var cam := get_viewport().get_camera_3d()
	var to_cam := (cam.global_position - _strike_pos).normalized() if cam else Vector3.BACK
	_bolt_mesh.clear_surfaces()
	_bolt_mesh.surface_begin(Mesh.PRIMITIVE_TRIANGLES)
	var top := _strike_pos + Vector3(_storm_rng.randf_range(-10, 10), _storm_rng.randf_range(26.0, 40.0), 0)
	_bolt_branch(top, _strike_pos + Vector3(0, -2, 0), 0.5, 16, to_cam)
	for b in 2:
		var from := top.lerp(_strike_pos, _storm_rng.randf_range(0.2, 0.5))
		var to := from + Vector3(_storm_rng.randf_range(-14, 14), -_storm_rng.randf_range(8, 16), _storm_rng.randf_range(-6, 6))
		_bolt_branch(from, to, 0.25, 7, to_cam)
	_bolt_mesh.surface_end()


func _bolt_branch(a: Vector3, b: Vector3, w: float, steps: int, to_cam: Vector3) -> void:
	var prev := a
	for i in steps:
		var f := float(i + 1) / steps
		var p := a.lerp(b, f)
		if i < steps - 1:
			p += Vector3(_storm_rng.randf_range(-1, 1), _storm_rng.randf_range(-0.3, 0.3), _storm_rng.randf_range(-1, 1)) * 2.4
		var dir := (p - prev).normalized()
		var side := dir.cross(to_cam).normalized() * w * (1.0 - 0.5 * f)
		for v in [prev - side, prev + side, p + side, prev - side, p + side, p - side]:
			_bolt_mesh.surface_add_vertex(v)
		prev = p
