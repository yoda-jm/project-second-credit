func _mountain_ring(rng: RandomNumberGenerator, c: Vector3, r0: float, r1: float, y0: float, a0: float,
		a1: float) -> ArrayMesh:
	var cols := 72
	var rows := 7
	var noise := FastNoiseLite.new()
	noise.seed = rng.randi()
	noise.frequency = 0.12
	var pts: Array = []
	for j in rows + 1:
		var row: Array = []
		var f := float(j) / rows
		for i in cols + 1:
			var a := lerpf(a0, a1, float(i) / cols)
			var r := lerpf(r0, r1, f)
			# peaks: tallest in the middle rows, a sharp ridge line
			var ridge := 1.0 - absf(f - 0.55) * 2.0
			var h := maxf(0.0, ridge) * (10.0 + 34.0 * absf(noise.get_noise_2d(i * 1.0, j * 1.6)) + 16.0 * absf(noise.get_noise_2d(i * 3.1, 7.0)))
			if j == 0 or j == rows:
				h = 0.0
			# the axis: forward (+z) is angle 0
			row.append(c + Vector3(sin(a) * r, y0 + h, cos(a) * r))
		pts.append(row)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for j in rows:
		for i in cols:
			var p00: Vector3 = pts[j][i]
			var p10: Vector3 = pts[j][i + 1]
			var p01: Vector3 = pts[j + 1][i]
			var p11: Vector3 = pts[j + 1][i + 1]
			_bary_tri(st, p00, p10, p11, y0, 70.0)
			_bary_tri(st, p00, p11, p01, y0, 70.0)
	return st.commit()


func _bary_tri(st: SurfaceTool, a: Vector3, b: Vector3, c: Vector3, y0: float, span: float) -> void:
	var n := (c - a).cross(b - a).normalized()
	var cols := [Color(1, 0, 0), Color(0, 1, 0), Color(0, 0, 1)]
	var ps := [a, b, c]
	for k in 3:
		st.set_normal(n)
		st.set_color(cols[k])
		st.set_uv(Vector2(0.0, clampf(((ps[k] as Vector3).y - y0) / span, 0.0, 1.0)))
		st.add_vertex(ps[k])


## An indexed triangle soup [vertices, indices] made into an unindexed wireframe-ready mesh.
func _wire_mesh(arr: Array) -> ArrayMesh:
	var vs: PackedVector3Array = arr[0]
	var ix: PackedInt32Array = arr[1]
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var lo := INF
	var hi := -INF
	for v in vs:
		lo = minf(lo, v.y)
		hi = maxf(hi, v.y)
	for t in range(0, ix.size(), 3):
		_bary_tri(st, vs[ix[t]], vs[ix[t + 1]], vs[ix[t + 2]], lo, maxf(hi - lo, 0.001))
	return st.commit()


func _octa(r: float) -> Array:
	var vs := PackedVector3Array([Vector3(r, 0, 0), Vector3(-r, 0, 0), Vector3(0, r * 1.4, 0), Vector3(0, -r * 1.4, 0),
			Vector3(0, 0, r), Vector3(0, 0, -r)])
	var ix := PackedInt32Array([0, 2, 4, 4, 2, 1, 1, 2, 5, 5, 2, 0, 0, 4, 3, 4, 1, 3, 1, 5, 3, 5, 0, 3])
	return [vs, ix]


func _pyramid(r: float) -> Array:
	var vs := PackedVector3Array([Vector3(-r, -r * 0.6, -r), Vector3(r, -r * 0.6, -r), Vector3(r, -r * 0.6, r),
			Vector3(-r, -r * 0.6, r), Vector3(0, r, 0)])
	var ix := PackedInt32Array([0, 1, 4, 1, 2, 4, 2, 3, 4, 3, 0, 4, 0, 2, 1, 0, 3, 2])
	return [vs, ix]


func _torus_arrays(r: float, rr: float, seg: int, sides: int) -> Array:
	var vs := PackedVector3Array()
	var ix := PackedInt32Array()
	for i in seg:
		var a := TAU * i / seg
		for j in sides:
			var b := TAU * j / sides
			vs.append(Vector3(cos(a) * (r + rr * cos(b)), rr * sin(b), sin(a) * (r + rr * cos(b))))
	for i in seg:
		for j in sides:
			var a0 := i * sides + j
			var a1 := ((i + 1) % seg) * sides + j
			var b0 := i * sides + (j + 1) % sides
			var b1 := ((i + 1) % seg) * sides + (j + 1) % sides
			ix.append_array([a0, a1, b1, a0, b1, b0])
	return [vs, ix]


