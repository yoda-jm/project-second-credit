# --- environment -----------------------------------------------------------------------------------------------

## The environment for a theme: PopBackdrop's keys (sky_top, sky_horizon, ground_horizon, ground_bottom, sun_color,
## sun_rotation, sun_energy, ambient_color, ambient_energy, fog_color, fog_density, fog_sun_scatter, exposure,
## glow_intensity, glow_threshold, saturation, contrast, night) plus sky_material (ShaderMaterial for a Sky: the
## theme's sky, also what the glossy course reflects), fog_height and fog_height_density (the abyss fog), name.
func environment_for(t: int) -> Dictionary:
	var d: Dictionary = THEMES[clampi(t, 0, THEMES.size() - 1)]
	var out := {}
	for k in ["sun_color", "sun_energy", "ambient_color", "ambient_energy", "fog_color", "fog_density",
			"fog_sun_scatter", "fog_height", "fog_height_density", "exposure", "glow_intensity", "glow_threshold",
			"saturation", "contrast", "night", "name"]:
		out[k] = d[k]
	out["sky_top"] = d["sky_top"]
	out["sky_horizon"] = d["sky_horizon"]
	out["ground_horizon"] = d["sky_below"]
	out["ground_bottom"] = d["sky_deep"]
	var l: Vector3 = (d.get("light_dir", d["sun_dir"]) as Vector3).normalized()
	out["sun_rotation"] = Vector3(rad_to_deg(asin(-l.y)), rad_to_deg(atan2(l.x, l.z)), 0.0)
	out["sky_material"] = sky_material(t)
	return out


## The theme's sky as a ShaderMaterial for a Sky resource (static: its radiance is baked once).
func sky_material(t: int) -> ShaderMaterial:
	var d: Dictionary = THEMES[clampi(t, 0, THEMES.size() - 1)]
	var m := ShaderMaterial.new()
	m.shader = load(SH + "drift_sky.gdshader")
	m.set_shader_parameter("top", d["sky_top"])
	m.set_shader_parameter("mid", d["sky_mid"])
	m.set_shader_parameter("horizon", d["sky_horizon"])
	m.set_shader_parameter("below", d["sky_below"])
	m.set_shader_parameter("deep", d["sky_deep"])
	m.set_shader_parameter("sun_dir", (d["sun_dir"] as Vector3).normalized())
	m.set_shader_parameter("sun_col", d["sun_color"])
	m.set_shader_parameter("sun_disc", d["sun_disc"])
	m.set_shader_parameter("sun_size", d["sun_size"])
	m.set_shader_parameter("sun_glow", d["sun_glow"])
	m.set_shader_parameter("synth_sun", d["synth"])
	m.set_shader_parameter("streaks", d["streaks"])
	m.set_shader_parameter("streak_col", d["streak_col"])
	m.set_shader_parameter("stars", d["stars"])
	m.set_shader_parameter("nebula", d["nebula"])
	if d.has("neb_a"):
		m.set_shader_parameter("neb_a", d["neb_a"])
		m.set_shader_parameter("neb_b", d["neb_b"])
		m.set_shader_parameter("neb_axis", d["neb_axis"])
	m.set_shader_parameter("aurora", d["aurora"])
	if d.has("aurora_col"):
		m.set_shader_parameter("aurora_col", d["aurora_col"])
		m.set_shader_parameter("aurora_dir", d["aurora_dir"])
	return m


## A ready Environment from environment_for()'s dictionary (the view may use it as is or copy the values).
static func make_environment(d: Dictionary) -> Environment:
	var env := Environment.new()
	var sky := Sky.new()
	if d.has("sky_material"):
		sky.sky_material = d["sky_material"]
	else:
		var sm := ProceduralSkyMaterial.new()
		sm.sky_top_color = d["sky_top"]
		sm.sky_horizon_color = d["sky_horizon"]
		sm.ground_horizon_color = d["ground_horizon"]
		sm.ground_bottom_color = d["ground_bottom"]
		sky.sky_material = sm
	sky.radiance_size = Sky.RADIANCE_SIZE_128
	env.sky = sky
	env.background_mode = Environment.BG_SKY
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_color = d["ambient_color"]
	env.ambient_light_energy = d["ambient_energy"]
	env.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.tonemap_exposure = d["exposure"]
	env.tonemap_white = 6.0
	env.fog_enabled = true
	env.fog_mode = Environment.FOG_MODE_EXPONENTIAL
	env.fog_light_color = d["fog_color"]
	env.fog_density = d["fog_density"]
	env.fog_sun_scatter = d["fog_sun_scatter"]
	env.fog_sky_affect = 0.0
	env.fog_height = d.get("fog_height", 0.0)
	env.fog_height_density = d.get("fog_height_density", 0.0)
	env.glow_enabled = true
	env.glow_intensity = d["glow_intensity"]
	env.glow_hdr_threshold = d["glow_threshold"]
	env.glow_bloom = 0.04
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_SOFTLIGHT
	env.set_glow_level(2, 1.0)
	env.set_glow_level(3, 0.8)
	env.set_glow_level(4, 0.6)
	env.set_glow_level(5, 0.3)
	env.ssr_enabled = d.get("ssr", false)   # optional: the tiles mirror the walls and the marble (costly)
	env.ssr_max_steps = 48
	env.ssr_fade_in = 0.1
	env.ssr_fade_out = 3.0
	env.ssr_depth_tolerance = 0.4
	env.adjustment_enabled = true
	env.adjustment_saturation = d["saturation"]
	env.adjustment_contrast = d["contrast"]
	return env


static func setup_sun(sun: DirectionalLight3D, d: Dictionary) -> void:
	sun.rotation_degrees = d["sun_rotation"]
	sun.light_color = d["sun_color"]
	sun.light_energy = d["sun_energy"]
	sun.light_specular = 0.6
	sun.shadow_enabled = true
	sun.shadow_blur = 1.5
	sun.directional_shadow_max_distance = 70.0


## The course shaders' settings for a theme. Every key is a uniform of course_top.gdshader and/or
## course_side.gdshader with the same name, so a view can copy them all in (set_shader_parameter(k, v) for each key
## on both materials; a key the shader lacks is ignored): tile_a, tile_b (the chequer), seam (the glowing seams and
## side strips), side (cliff panels), accent (goal lights, wall trim band), trim (wall tops), glass, acid, abyss
## (where the sides fade to), and for some themes gloss and seam_energy (floats).
func palette(t: int) -> Dictionary:
	return (THEMES[clampi(t, 0, THEMES.size() - 1)]["palette"] as Dictionary).duplicate()


## Ready materials for the course mesh: [top (course_top.gdshader), side (course_side.gdshader)], set from palette().
## fade_top / fade_bottom: the world heights where the sides start and finish fading into the abyss.
func course_materials(t: int, fade_top := -2.0, fade_bottom := -14.0) -> Array[ShaderMaterial]:
	var p := palette(t)
	var top := ShaderMaterial.new()
	top.shader = load(SH + "course_top.gdshader")
	var side := ShaderMaterial.new()
	side.shader = load(SH + "course_side.gdshader")
	for k in p:
		top.set_shader_parameter(k, p[k])
		side.set_shader_parameter(k, p[k])
	side.set_shader_parameter("fade_top", fade_top)
	side.set_shader_parameter("fade_bottom", fade_bottom)
	return [top, side]


# --- building --------------------------------------------------------------------------------------------------

## Builds the diorama for a theme round a course of the given size (x across, y the height range, z its length).
func build(t: int, size := Vector3(18, 12, 56)) -> void:
	for c in get_children():
		remove_child(c)
		c.queue_free()
	theme = clampi(t, 0, THEMES.size() - 1)
	course_size = size
	_t = 0.0
	_clocked.clear()
	_follow.clear()
	_bob.clear()
	_spin.clear()
	_focus_fx.clear()
	_flash_mats.clear()
	_flash_light = null
	_bolt = null
	_storm_rng.seed = 4700 + theme
	_next_strike = 2.5
	_strike_t = -10.0
	var d: Dictionary = THEMES[theme]
	if d.has("deck"):
		_add_deck(d)
	if d.has("grid"):
		_add_grid(d)
	var rng := RandomNumberGenerator.new()
	rng.seed = 2700 + theme * 31
	match theme:
		0: _build_dawn(d, rng)
		1: _build_space(d, rng)
		2: _build_cavern(d, rng)
		3: _build_synth(d, rng)
		4: _build_storm(d, rng)
		5: _build_polar(d, rng)
	_cam_pos = Vector3(size.x * 0.5 - 20.0, 30.0, -20.0)
	_place_follow()


func _centre() -> Vector3:
	return Vector3(course_size.x * 0.5, 0.0, course_size.z * 0.5)


func _shader(n: String, clocked := true) -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = load(SH + n + ".gdshader")
	if clocked:
		_clocked.append(m)
	return m


func _mi(nm: String, mesh: Mesh, mat: Material, pos: Vector3, shadow := false) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	mi.name = nm
	mi.mesh = mesh
	mi.material_override = mat
	mi.position = pos
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON if shadow else GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	mi.gi_mode = GeometryInstance3D.GI_MODE_DISABLED
	add_child(mi)
	return mi


## A random spot round the course for a distant object, mostly on the side the game's camera looks towards (it sits
## at +x +z of the marble looking back up the course, towards -x -z): beside a point along the course, `clear` to
## `clear + reach` away, at a height between y1 (near) and y0 (far). Never right under the course.
func _spot(rng: RandomNumberGenerator, clear: float, reach: float, y0: float, y1: float) -> Vector3:
	var along := rng.randf_range(-40.0, course_size.z + 30.0)
	var a := deg_to_rad(-135.0) + rng.randf_range(-1.0, 1.0) * deg_to_rad(120.0)
	var k := pow(rng.randf(), 0.8)
	var off := clear + k * reach
	var hw := course_size.x * 0.5
	var p := Vector3(hw + sin(a) * (hw + off), 0.0, along + cos(a) * off)
	if absf(p.x - hw) < hw + clear and p.z > -clear and p.z < course_size.z + clear:
		p.x = hw + signf(p.x - hw + 0.01) * (hw + clear + k * reach * 0.5)
	p.y = lerpf(y1, y0, clampf(k * 0.7 + rng.randf() * 0.3, 0.0, 1.0))
	return p


