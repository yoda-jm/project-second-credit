## A cluster of faceted crystals with pointed tips (UV.y 0 base .. 1 tip; COLOR.r phase, COLOR.g brightness).
func _crystal_cluster(rng: RandomNumberGenerator, hgt: float, rad: float, count: int, sides: int, jag: float,
		single := false) -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for c in count:
		var h := hgt * (1.0 if c == 0 else rng.randf_range(0.35, 0.8))
		var r := rad * (1.0 if c == 0 else rng.randf_range(0.35, 0.7)) * (h / hgt) ** 0.3
		var tilt := Basis()
		var base := Vector3.ZERO
		if c > 0:
			tilt = Basis(Vector3(rng.randf() - 0.5, 0, rng.randf() - 0.5).normalized(), rng.randf_range(0.2, 0.6))
			base = Vector3(rng.randf_range(-1, 1), 0, rng.randf_range(-1, 1)) * rad * 0.9
		if single:
			base = Vector3(0, -h * 0.5, 0)
		var col := Color(rng.randf(), rng.randf_range(0.7, 1.1), 0)
		var shoulder := h - r * 1.8
		var ring0: Array = []
		var ring1: Array = []
		var off := rng.randf() * TAU
		for s in sides:
			var a := off + TAU * s / sides
			var j := 1.0 + jag * (rng.randf() - 0.5)
			ring0.append(base + tilt * Vector3(cos(a) * r * j, 0, sin(a) * r * j))
			ring1.append(base + tilt * Vector3(cos(a) * r * 0.86 * j, shoulder, sin(a) * r * 0.86 * j))
		var apex := base + tilt * Vector3(r * 0.1, h, 0)
		var axis := base + tilt * Vector3(0, h * 0.5, 0)
		var v0 := 0.0
		var v1 := shoulder / h
		for s in sides:
			var n := (s + 1) % sides
			_tri_uv(st, [ring0[s], ring1[s], ring1[n]], [v0, v1, v1], axis, col)
			_tri_uv(st, [ring0[s], ring1[n], ring0[n]], [v0, v1, v0], axis, col)
			_tri_uv(st, [ring1[s], apex, ring1[n]], [v1, 1.0, v1], axis, col)
			if single:
				var bottom := base + tilt * Vector3(0, -r * 1.6, 0)
				_tri_uv(st, [ring0[s], ring0[n], bottom], [v0, v0, 0.0], axis, col)
	return st.commit()


## One triangle with the outward-facing winding (Godot's front faces are clockwise) and its face normal.
func _tri_uv(st: SurfaceTool, p: Array, v: Array, inside: Vector3, col: Color) -> void:
	var a: Vector3 = p[0]
	var b: Vector3 = p[1]
	var c: Vector3 = p[2]
	var va: float = v[0]
	var vb: float = v[1]
	var vc: float = v[2]
	var n := (c - a).cross(b - a)
	if n.dot((a + b + c) / 3.0 - inside) < 0.0:
		var tb := b
		b = c
		c = tb
		var tv := vb
		vb = vc
		vc = tv
		n = -n
	n = n.normalized()
	for q in [[a, va], [b, vb], [c, vc]]:
		st.set_normal(n)
		st.set_color(col)
		st.set_uv(Vector2(0.0, q[1]))
		st.add_vertex(q[0])


